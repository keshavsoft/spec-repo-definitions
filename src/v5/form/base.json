{
  "tagName": "div",
  "attributes": {
    "class": "card shadow-sm border-0"
  },
  "children": [
    {
      "tagName": "div",
      "attributes": {
        "class": "card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center"
      },
      "children": [
        {
          "tagName": "h2",
          "textContent": "${title}",
          "attributes": {
            "class": "h5 fw-bold mb-0 text-dark"
          }
        }
      ]
    },
    {
      "tagName": "div",
      "attributes": {
        "class": "card-body p-4"
      },
      "children": [
        {
          "tagName": "form",
          "attributes": {
            "id": "${formId}",
            "data-role": "form-body"
          },
          "children": []
        }
      ]
    }
  ]
}
