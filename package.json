{
  "name": "spec-repo-definitions",
  "version": "1.7.1",
  "description": "Modular, versioned JSON-to-DOM definitions and compiler wrapper for KeshavSoft spec-repo.",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./dist/*": "./dist/*",
    "./src/*": "./src/*"
  },
  "bin": {
    "spec-repo-definitions": "bin/cli.js"
  },
  "files": [
    "dist",
    "src",
    "bin"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "deliver": "node scripts/build.js --deliver",
    "test": "node scripts/test.js",
    "prepublishOnly": "npm run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keshavsoft/spec-repo-definitions.git"
  },
  "keywords": [
    "spec-repo",
    "spec-repo-definitions",
    "json-to-dom",
    "declarative-ui",
    "dom-builder",
    "schema-definitions"
  ],
  "author": "KeshavSoft",
  "license": "ISC",
  "type": "module"
}